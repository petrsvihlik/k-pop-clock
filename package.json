{
  "name": "k-pop-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Time Islands — a client-side, browser-only educational game for learning to read the clock, built on a small extendable game engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
